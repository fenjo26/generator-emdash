---
import Base from "../layouts/Base.astro";
import GameHero from "../components/GameHero.astro";
import pagesData from "../data/pages.json";
import brand from "../brand.json";

const mainPage = (pagesData as any[]).find((p: any) => p.id === "main") ?? null;
const articles  = (pagesData as any[]).filter((p: any) => p.id !== "main");

const siteName = brand.siteName || "GameGuide";
const siteDesc = (mainPage?.data?.seo_desc as string) || "";

// Extract H1 from html_content, leave the rest as body
const rawHtml  = (mainPage?.data?.html_content as string) ?? "";
const h1Match  = rawHtml.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
const heroH1   = h1Match ? h1Match[1].replace(/<[^>]+>/g, "").trim() : siteName;
const bodyHtml = rawHtml.replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, "").trim();

const hasBrand = !!brand.name && !!brand.url;
---

<Base title={undefined} description={siteDesc}>

  <!-- Game Hero block (only when game.txt is present) -->
  <GameHero />

  <!-- Main hero with H1 -->
  <section class="hero">
    <img src="/banner.webp" alt={siteName} class="hero__bg" onerror="this.style.display='none'" />
    <div class="container hero__inner">
      <span class="hero__label">Game Guide</span>
      <h1 class="hero__title">{heroH1}</h1>
      {siteDesc && <p class="hero__desc">{siteDesc}</p>}
    </div>
  </section>

  <!-- Affiliate CTA bar (only when brand set) -->
  {hasBrand && (
    <div class="hero-cta">
      <div class="container hero-cta__inner">
        <span class="hero-cta__label">
          Παίξε στο <strong>{brand.name}</strong> — Αξιόπιστο καζίνο για Έλληνες παίκτες
        </span>
        <a href={brand.url} target="_blank" rel="noopener sponsored" class="btn-bonus">
          🎁 Πάρε το Μπόνους
        </a>
      </div>
    </div>
  )}

  <!-- Promo slides (only when brand set) -->
  {hasBrand && (
    <div class="container">
      <div class="promo-slides" id="promo-slides">
        <div class="promo-slide promo-slide--1 is-active">
          <a href={brand.url} target="_blank" rel="nofollow noopener sponsored">
            <img src="/slides/slide1.webp" alt="promo-1"
              onerror="this.closest('.promo-slide').style.display='none'" />
            <div class="promo-slide__body">
              <p class="promo-slide__text">Κάνε κατάθεση<br/>και πάρε το μπόνους</p>
              <span class="promo-slide__btn">Τώρα</span>
            </div>
          </a>
        </div>

        <div class="promo-slide promo-slide--2">
          <a href={brand.url} target="_blank" rel="nofollow noopener sponsored">
            <img src="/slides/slide2.webp" alt="promo-2"
              onerror="this.closest('.promo-slide').style.display='none'" />
            <div class="promo-slide__body">
              <p class="promo-slide__text">Drops &amp; Wins</p>
              <p class="promo-slide__amount">€3000</p>
              <div class="promo-slide__btns">
                <span class="promo-slide__btn promo-slide__btn--yellow">Συμμετοχή</span>
                <span class="promo-slide__btn promo-slide__btn--outline">Περισσότερα</span>
              </div>
            </div>
          </a>
        </div>

        <div class="promo-dots">
          <button class="promo-dot is-active" data-idx="0" aria-label="Slide 1"></button>
          <button class="promo-dot" data-idx="1" aria-label="Slide 2"></button>
        </div>
      </div>
    </div>

    <script>
      const slides = Array.from(document.querySelectorAll('.promo-slide'));
      const dots   = Array.from(document.querySelectorAll('.promo-dot'));
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function goTo(idx: number) {
        slides[current].classList.remove('is-active');
        dots[current].classList.remove('is-active');
        current = idx % slides.length;
        slides[current].classList.add('is-active');
        dots[current].classList.add('is-active');
      }

      function startAuto() { timer = setInterval(() => goTo(current + 1), 4000); }

      dots.forEach(dot => dot.addEventListener('click', () => {
        clearInterval(timer);
        goTo(Number((dot as HTMLElement).dataset.idx));
        startAuto();
      }));

      startAuto();
    </script>
  )}

  <!-- SEO content from main.txt (H1 is already in hero above) -->
  {bodyHtml && (
    <section class="section">
      <div class="container">
        <div class="article-layout article-layout--full">
          <div class="article-content" set:html={bodyHtml} />
        </div>
      </div>
    </section>
  )}

  <!-- Articles grid -->
  {articles.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2 class="section__title">Οδηγοί &amp; Άρθρα</h2>
        <div class="articles-grid">
          {articles.map((article: any) => (
            <a href={`/${article.id}/`} class="article-card">
              <div class="article-card__title">{article.data.title}</div>
              {article.data.seo_desc && (
                <div class="article-card__desc">{article.data.seo_desc}</div>
              )}
              <div class="article-card__arrow">Διαβάστε περισσότερα →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Base>
