---
import Base from "../layouts/Base.astro";
---
<Base title="Страница не найдена">
  <div style="text-align:center; padding: 6rem 1rem;">
    <h1 style="font-size:5rem; font-weight:900; color:var(--color-accent);">404</h1>
    <p style="font-size:var(--font-size-xl); color:var(--color-text-secondary); margin: 1rem 0 2rem;">
      Страница не найдена
    </p>
    <a href="/" class="btn btn--primary">← На главную</a>
  </div>
</Base>
