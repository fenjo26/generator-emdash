---
import Base from "../../layouts/Base.astro";
import authorsData from "../../data/authors.json";

export function getStaticPaths() {
  return (authorsData as any[]).map((author: any) => ({
    params: { slug: author.id },
    props:  { author },
  }));
}

const { author } = Astro.props as { author: any };
const name    = (author.data?.title        as string) ?? "";
const seoDesc = (author.data?.seo_desc     as string) ?? "";
const bio     = (author.data?.html_content as string) ?? "";
const photo   = author.data?.photo as { src?: string; alt?: string } | null | undefined;
const photoSrc = photo?.src ?? `/authors/${author.id}.webp`;

const origin    = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const authorUrl = `${origin}/authors/${author.id}/`;

const personData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": name,
  "url": authorUrl,
  "description": seoDesc || undefined,
  "image": `${origin}${photoSrc}`,
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική",    "item": `${origin}/` },
    { "@type": "ListItem", "position": 2, "name": "Συντάκτης", "item": `${origin}/authors/` },
    { "@type": "ListItem", "position": 3, "name": name,         "item": authorUrl },
  ],
};
---

<Base title={name} description={seoDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(personData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <div class="container" style="padding-top:1.5rem;">
    <nav class="breadcrumb">
      <a href="/">Αρχική</a>
      <span>›</span>
      <span>Συντάκτης</span>
      <span>›</span>
      <span>{name}</span>
    </nav>
  </div>

  <div class="container">
    <div class="article-layout article-layout--full" style="padding-top:2rem;">
      <article>
        <div style="display:flex; align-items:center; gap:1.25rem; margin-bottom:2rem; padding-bottom:1.5rem; border-bottom:1px solid var(--color-border);">
          <img
            src={photoSrc}
            alt={name}
            onerror="this.src='/favicon.svg'; this.style.padding='8px';"
            style="width:80px; height:80px; border-radius:50%; object-fit:cover; background:var(--color-surface-2); flex-shrink:0;"
          />
          <div>
            <h1 style="font-size:1.75rem; font-weight:900; margin-bottom:0.25rem;">{name}</h1>
            {seoDesc && <p style="color:var(--color-text-2); font-size:0.95rem;">{seoDesc}</p>}
          </div>
        </div>
        {bio
          ? <div class="article-content" set:html={bio} />
          : <p style="color:var(--color-muted);">Βιογραφικό σύντομα…</p>
        }
      </article>
    </div>
  </div>
</Base>
