---
import Base from "../layouts/Base.astro";
import GameHero from "../components/GameHero.astro";
import pagesData from "../data/pages.json";
import servicePagesData from "../data/service_pages.json";
import authorsData from "../data/authors.json";
import brand from "../brand.json";

export function getStaticPaths() {
  const allEntries = [
    ...(pagesData as any[]).filter((p: any) => p.id !== "main"),
    ...(servicePagesData as any[]),
  ];
  return allEntries.map((entry: any) => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const { slug }  = Astro.params;

const title   = (entry.data?.title        as string) ?? "";
const seoDesc = (entry.data?.seo_desc     as string) ?? "";
const rawHtml = (entry.data?.html_content as string) ?? "";

// Extract H1 from content
const h1Match  = rawHtml.match(/<h1[^>]*>([\s\S]*?)<\/h1>/i);
const pageH1   = h1Match ? h1Match[1].replace(/<[^>]+>/g, "").trim() : title;
const bodyHtml = rawHtml.replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, "").trim();

// Related articles for sidebar
const related = (pagesData as any[])
  .filter((p: any) => p.id !== "main" && p.id !== slug)
  .slice(0, 8);

// Table of Contents from H2 headings
function slugifyHeading(text: string): string {
  return text.toLowerCase()
    .replace(/<[^>]+>/g, "")
    .replace(/[^\w\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/^-+|-+$/g, "");
}

interface TocItem { id: string; text: string; }
const tocItems: TocItem[] = [];
const bodyHtmlWithAnchors = bodyHtml.replace(
  /<h2([^>]*)>([\s\S]*?)<\/h2>/gi,
  (_match: string, attrs: string, inner: string) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id   = slugifyHeading(text) || `section-${tocItems.length + 1}`;
    tocItems.push({ id, text });
    return `<h2${attrs} id="${id}">${inner}</h2>`;
  }
);

const hasBrand    = !!brand.name && !!brand.url;
const firstAuthor = (authorsData as any[])[0] ?? null;
const siteName    = brand.siteName || "GameGuide";
const origin      = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const pageUrl     = `${origin}/${slug}/`;
const siteUrl     = `${origin}/`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageH1,
  "description": seoDesc,
  "url": pageUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "publisher": {
    "@type": "Organization",
    "name": brand.name || siteName,
    "url": brand.url || siteUrl,
    "logo": { "@type": "ImageObject", "url": `${origin}/logo.webp` },
  },
  ...(firstAuthor ? {
    "author": {
      "@type": "Person",
      "name": firstAuthor.data.title,
      "url": `${origin}/authors/${firstAuthor.id}/`,
    },
  } : {}),
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Αρχική", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": pageH1,   "item": pageUrl },
  ],
};
---

<Base title={pageH1} description={seoDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />

  <div class="container" style="padding-top:1.5rem;">
    <nav class="breadcrumb">
      <a href="/">Αρχική</a>
      <span>›</span>
      <span>{pageH1}</span>
    </nav>
  </div>

  <!-- Game Hero block (only when game.txt is present) -->
  <div class="container">
    <GameHero />
  </div>

  <div class="container">
    <div class={`article-layout${!hasBrand && related.length === 0 ? " article-layout--full" : ""}`}>

      <article>
        <h1 style="font-size:clamp(1.5rem,4vw,2.25rem); font-weight:900; line-height:1.2; margin-bottom:1.5rem;">
          {pageH1}
        </h1>

        {tocItems.length >= 3 && (
          <nav class="toc">
            <div class="toc__title">Περιεχόμενα</div>
            <ol class="toc__list">
              {tocItems.map((item, i) => (
                <li class="toc__item">
                  <a href={`#${item.id}`}>
                    <span class="toc__num">{i + 1}.</span>
                    {item.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        {bodyHtmlWithAnchors
          ? <div class="article-content" set:html={bodyHtmlWithAnchors} />
          : <p style="color:var(--color-muted);">Περιεχόμενο σύντομα…</p>
        }
      </article>

      {(hasBrand || related.length > 0) && (
        <aside class="sidebar">
          {hasBrand && (
            <div class="sidebar-card">
              <div class="sidebar-card__title">Προτεινόμενο Καζίνο</div>
              <div class="sidebar-brand__name">{brand.name}</div>
              <p style="font-size:0.8rem; color:var(--color-text-2); margin:0.5rem 0;">
                Ασφαλές και αξιόπιστο καζίνο για Έλληνες παίκτες.
              </p>
              <a href={brand.url} target="_blank" rel="noopener sponsored" class="sidebar-brand__cta">
                Παίξε στο {brand.name} →
              </a>
            </div>
          )}

          {related.length > 0 && (
            <div class="sidebar-card">
              <div class="sidebar-card__title">Σχετικά Άρθρα</div>
              <ul class="sidebar-nav">
                {related.map((p: any) => (
                  <li>
                    <a href={`/${p.id}/`}>
                      {(p.data.title as string).split(/[|:—–]/)[0].trim()}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}
    </div>
  </div>
</Base>
