---
import "../styles/theme.css";
import brand from "../brand.json";
import pagesData from "../data/pages.json";
import servicePages from "../data/service_pages.json";
import authors from "../data/authors.json";

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const siteName = brand.siteName || "GameGuide";
const { title, description = "", noIndex = false } = Astro.props;
const pageTitle = title ? `${title} — ${siteName}` : siteName;

// Canonical always with trailing slash
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith("/") ? rawPath : rawPath + "/";
const origin = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, "");
const canonicalUrl = `${origin}${normalizedPath}`;

const navPages = (pagesData as any[])
  .filter((p: any) => p.id !== "main" && p.data?.title)
  .slice(0, 5);

const hasBrand = !!brand.name && !!brand.url;
const firstAuthor = (authors as any[])[0] ?? null;

function slugToLabel(slug: string): string {
  const GAME_PREFIX = /^(cs2?|bf[0-9]+|cod|gta[0-9]*|lol|wow|pubg|dota2?|apex|valorant|minecraft|fortnite|counter.?strike.?[0-9]*|battlefield.?[0-9]*)[-_]/i;
  const YEAR_SUFFIX = /[-_]?\d{4}[a-z]?$/i;
  return slug
    .replace(GAME_PREFIX, "")
    .replace(YEAR_SUFFIX, "")
    .split(/[-_]/)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ")
    .trim() || slug;
}
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex,nofollow" : "index,follow"} />
    {firstAuthor && <meta name="author" content={firstAuthor.data.title} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:site_name"   content={siteName} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": `${origin}/`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": `${origin}/search?q={search_term_string}` },
        "query-input": "required name=search_term_string",
      },
    })} />
  </head>
  <body>

    <!-- Affiliate Brand Banner (only when brand set) -->
    {hasBrand && (
      <div class="brand-banner">
        <div class="container brand-banner__inner">
          <span class="brand-banner__text">Παίξε στο <strong>{brand.name}</strong> — Αξιόπιστο καζίνο για παικτές</span>
          <a href={brand.url} target="_blank" rel="noopener sponsored" class="brand-banner__cta">
            Επισκεφθείτε το {brand.name} →
          </a>
        </div>
      </div>
    )}

    <!-- Header -->
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__logo">
          <img
            src="/logo.webp"
            alt={siteName}
            class="site-header__logo-img"
            onerror="this.style.display='none'; document.getElementById('logo-text').style.display='inline';"
          />
          <span id="logo-text" style="display:none">
            <span>{siteName.charAt(0)}</span>{siteName.slice(1)}
          </span>
        </a>

        <nav class="site-header__nav">
          <a href="/">Αρχική</a>
          {navPages.map((p: any) => (
            <a href={`/${p.id}/`}>{slugToLabel(p.id)}</a>
          ))}
        </nav>

        <button class="burger" id="burger-btn" aria-label="Μενού" aria-expanded="false">
          <span class="burger__line"></span>
          <span class="burger__line"></span>
          <span class="burger__line"></span>
        </button>
      </div>
    </header>

    <!-- Mobile nav -->
    <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
      <div class="mobile-nav__overlay" id="nav-overlay"></div>
      <nav class="mobile-nav__drawer">
        <a href="/">Αρχική</a>
        {navPages.map((p: any) => (
          <a href={`/${p.id}/`}>{slugToLabel(p.id)}</a>
        ))}
        {hasBrand && (
          <a href={brand.url} target="_blank" rel="noopener sponsored" class="mobile-nav__cta">
            🎁 Πάρε το Μπόνους
          </a>
        )}
      </nav>
    </div>

    <script>
      const btn     = document.getElementById("burger-btn")!;
      const nav     = document.getElementById("mobile-nav")!;
      const overlay = document.getElementById("nav-overlay")!;
      const open  = () => { nav.classList.add("is-open");    btn.classList.add("is-open");    btn.setAttribute("aria-expanded","true");  nav.setAttribute("aria-hidden","false"); document.body.style.overflow="hidden"; };
      const close = () => { nav.classList.remove("is-open"); btn.classList.remove("is-open"); btn.setAttribute("aria-expanded","false"); nav.setAttribute("aria-hidden","true");  document.body.style.overflow=""; };
      btn.addEventListener("click", () => nav.classList.contains("is-open") ? close() : open());
      overlay.addEventListener("click", close);
      document.addEventListener("keydown", e => e.key === "Escape" && close());
    </script>

    <main><slot /></main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">

        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-brand__name">{siteName}</a>
            {hasBrand && (
              <a href={brand.url} target="_blank" rel="noopener sponsored" class="footer-brand__cta">
                🎁 {brand.name}
              </a>
            )}
          </div>

          {navPages.length > 0 && (
            <div class="footer-col">
              <div class="footer-col__heading">Οδηγοί</div>
              <ul class="footer-col__list">
                {navPages.map((p: any) => (
                  <li><a href={`/${p.id}/`}>{slugToLabel(p.id)}</a></li>
                ))}
              </ul>
            </div>
          )}

          {(servicePages as any[]).length > 0 && (
            <div class="footer-col">
              <div class="footer-col__heading">Πληροφορίες</div>
              <ul class="footer-col__list">
                {(servicePages as any[]).map((p: any) => (
                  <li>
                    <a href={`/${p.id}/`}>
                      {((p.data?.title as string) ?? p.id).split(/[|:—–]/)[0].trim()}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        {hasBrand && (
          <div class="footer-payments">
            <div class="footer-payments__label">Μέθοδοι Πληρωμής</div>
            <div class="footer-payments__icons">
              <img src="/icons/visa.svg"       alt="Visa"       class="footer-pay-icon" />
              <img src="/icons/mastercard.svg" alt="Mastercard" class="footer-pay-icon" />
              <img src="/icons/btc.svg"        alt="Bitcoin"    class="footer-pay-icon footer-pay-icon--crypto" />
              <img src="/icons/eth.svg"        alt="Ethereum"   class="footer-pay-icon footer-pay-icon--crypto" />
              <img src="/icons/usdt.svg"       alt="USDT"       class="footer-pay-icon footer-pay-icon--crypto" />
              <img src="/icons/sol.svg"        alt="Solana"     class="footer-pay-icon footer-pay-icon--crypto" />
              <img src="/icons/trx.svg"        alt="TRON"       class="footer-pay-icon footer-pay-icon--crypto" />
            </div>
          </div>
        )}

        {hasBrand && (
          <div class="footer-disclaimer">
            <span class="footer-disclaimer__label">ΠΑΙΞΕ ΥΠΕΥΘΥΝΑ</span>
            Η συμμετοχή σε τυχερά παίγνια μπορεί να προκαλέσει εθισμό και απώλεια περιουσίας.
            Γραμμή βοήθειας ΚΕΘΕΑ: <strong>1114</strong>. Αρμόδιος Ρυθμιστής: ΕΕΕΠ.
            Η συμμετοχή επιτρέπεται μόνο σε άτομα άνω των <strong>21 ετών</strong>.
          </div>
        )}

        {hasBrand && (
          <div class="footer-compliance">
            <img src="/icons/mga.svg"           alt="Malta Gaming Authority" class="footer-compliance__logo" />
            <img src="/icons/begambleaware.svg" alt="BeGambleAware"          class="footer-compliance__logo" />
            <img src="/icons/gamcare.svg"       alt="GamCare"                class="footer-compliance__logo" />
            <img src="/icons/age18.svg"         alt="18+"                    class="footer-compliance__logo footer-compliance__logo--age" />
            <img src="/icons/dmca.svg"          alt="DMCA Protected"         class="footer-compliance__logo" />
          </div>
        )}

        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} {siteName}. Όλα τα δικαιώματα διατηρούνται.</span>
          {firstAuthor && (
            <span class="footer-bottom__author">
              Γράφτηκε από&nbsp;<a href={`/authors/${firstAuthor.id}/`}>{firstAuthor.data.title}</a>
            </span>
          )}
        </div>

      </div>
    </footer>
  </body>
</html>
